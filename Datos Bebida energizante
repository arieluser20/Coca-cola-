<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f0e8">
  <title>Archivo Coca-Cola | Explora la colección</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      color-scheme: light;
      --paper: #f4f0e8;
      --ink: #202522;
      --muted: #777a72;
      --red: #e51b32;
      --green: #315d4c;
      --line: #d8d5cc;
      --serif: Georgia, "Times New Roman", serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: "DM Sans", sans-serif; }
    button, input { font: inherit; }
    button { color: inherit; }
    .topbar { height: 70px; display: flex; align-items: center; justify-content: space-between; padding: 0 6vw; border-bottom: 1px solid var(--line); }
    .brand { display: flex; align-items: center; gap: 10px; color: var(--red); text-decoration: none; }
    .brand-mark { font-family: var(--serif); font-size: 25px; font-weight: 700; font-style: italic; letter-spacing: -1.5px; }
    .brand-note { color: var(--ink); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
    .toplink { color: var(--ink); font-size: 12px; font-weight: 700; text-decoration: none; text-transform: uppercase; }
    main { max-width: 1440px; margin: auto; padding: 38px 6vw 64px; }
    .intro { display: grid; grid-template-columns: 1fr minmax(260px, 410px); gap: 40px; align-items: end; padding: 4px 0 33px; }
    .eyebrow { margin: 0 0 13px; color: var(--green); font-size: 11px; font-weight: 700; letter-spacing: 1.7px; text-transform: uppercase; }
    h1 { max-width: 700px; margin: 0; font-family: "Oswald", sans-serif; font-size: clamp(42px, 6vw, 76px); font-weight: 600; line-height: .98; text-transform: uppercase; }
    .intro-copy { margin: 0 0 4px; color: #555a53; font-family: var(--serif); font-size: 17px; line-height: 1.65; }
    .feature { position: relative; min-height: 268px; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; background: #dbe4d8; }
    .feature-copy { z-index: 1; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 32px 4vw; }
    .feature-copy .eyebrow { color: var(--red); }
    .feature h2 { max-width: 380px; margin: 0 0 18px; font-family: "Oswald", sans-serif; font-size: clamp(30px, 4vw, 49px); font-weight: 600; line-height: 1.03; text-transform: uppercase; }
    .feature p:not(.eyebrow) { max-width: 370px; margin: 0 0 22px; color: #4e574f; font-size: 14px; line-height: 1.6; }
    .feature-image { min-height: 268px; background: #cbd8cc url("https://images.unsplash.com/photo-1554866585-cd94860890b7?auto=format&fit=crop&w=1300&q=85") center 48% / cover no-repeat; }
    .button { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border: 0; background: var(--red); color: white; cursor: pointer; font-size: 12px; font-weight: 700; text-decoration: none; text-transform: uppercase; transition: background .2s, transform .2s; }
    .button:hover { transform: translateY(-2px); background: #bd1025; }
    .collection { padding-top: 45px; }
    .collection-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    .collection-head h2 { margin: 0; font-family: "Oswald", sans-serif; font-size: 30px; font-weight: 600; text-transform: uppercase; }
    .count { color: var(--muted); font-size: 12px; }
    .controls { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .filters { display: flex; flex-wrap: wrap; gap: 7px; }
    .filter { min-height: 34px; padding: 0 12px; border: 1px solid transparent; background: transparent; color: #666a63; cursor: pointer; font-size: 12px; font-weight: 600; }
    .filter:hover, .filter.active { border-color: var(--ink); color: var(--ink); }
    .search { width: min(240px, 35vw); height: 37px; padding: 0 11px; border: 1px solid var(--line); background: transparent; outline: none; font-size: 12px; }
    .search:focus { border-color: var(--green); }
    .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; padding-top: 19px; }
    .product { min-width: 0; border-bottom: 1px solid var(--line); animation: appear .4s both; }
    .product-visual { position: relative; aspect-ratio: 1 / 1.04; overflow: hidden; background: #e7e2d9; }
    .product-visual img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .45s; }
    .product:hover img { transform: scale(1.035); }
    .product-tag { position: absolute; top: 11px; left: 11px; padding: 6px 8px; background: var(--paper); font-size: 9px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; }
    .heart { position: absolute; top: 9px; right: 9px; width: 35px; height: 35px; border: 0; border-radius: 50%; background: var(--paper); cursor: pointer; font-size: 18px; }
    .heart[aria-pressed="true"] { color: var(--red); }
    .product-info { display: flex; align-items: start; justify-content: space-between; gap: 10px; padding: 13px 2px 16px; }
    .product-info h3 { margin: 0 0 5px; font-family: "Oswald", sans-serif; font-size: 18px; font-weight: 500; text-transform: uppercase; }
    .product-info p { margin: 0; color: var(--muted); font-size: 11px; }
    .detail { flex: 0 0 auto; padding: 6px 0; border: 0; background: none; color: var(--green); cursor: pointer; font-size: 11px; font-weight: 700; }
    .empty { grid-column: 1 / -1; padding: 44px 0; color: var(--muted); font-family: var(--serif); font-size: 18px; }
    footer { display: flex; justify-content: space-between; gap: 20px; padding-top: 28px; color: var(--muted); font-size: 11px; }
    dialog { width: min(480px, calc(100% - 32px)); padding: 0; border: 0; background: var(--paper); color: var(--ink); }
    dialog::backdrop { background: rgb(24 28 24 / 65%); }
    .dialog-image { width: 100%; height: 230px; display: block; object-fit: cover; }
    .dialog-content { padding: 22px 25px 25px; }
    .dialog-content h2 { margin: 0 0 8px; font-family: "Oswald", sans-serif; font-size: 30px; text-transform: uppercase; }
    .dialog-content p { margin: 0 0 20px; color: #555a53; font-size: 14px; line-height: 1.6; }
    .close { float: right; padding: 7px 0; border: 0; background: none; cursor: pointer; font-size: 12px; font-weight: 700; }
    @keyframes appear { from { opacity: 0; transform: translateY(9px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 800px) {
      main { padding: 30px 5vw 48px; }
      .intro { grid-template-columns: 1fr; gap: 18px; }
      .intro-copy { max-width: 540px; }
      .feature { grid-template-columns: 1fr .8fr; }
      .feature-copy { padding: 26px 5vw; }
      .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    }
    @media (max-width: 520px) {
      .topbar { height: 60px; padding: 0 5vw; }
      .brand-note { display: none; }
      main { padding-top: 25px; }
      .feature { grid-template-columns: 1fr; }
      .feature-copy { padding: 27px 22px; }
      .feature-image { min-height: 190px; }
      .controls { align-items: stretch; flex-direction: column; }
      .search { width: 100%; }
      .collection-head { align-items: start; flex-direction: column; gap: 5px; }
      .product-info h3 { font-size: 16px; }
      footer { flex-direction: column; gap: 7px; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#inicio" aria-label="Archivo Coca-Cola, inicio">
      <span class="brand-mark">Coca-Cola</span>
      <span class="brand-note">Archivo de bebidas</span>
    </a>
    <a class="toplink" href="#coleccion">Mi colección <span id="favorite-count">0</span></a>
  </header>
  <main id="inicio">
    <section class="intro" aria-labelledby="page-title">
      <div>
        <p class="eyebrow">Una historia para descubrir</p>
        <h1 id="page-title">Mucho más que una bebida</h1>
      </div>
      <p class="intro-copy">Explora sabores, conoce sus historias y encuentra tu favorita en este pequeño archivo dedicado al universo Coca-Cola.</p>
    </section>
    <section class="feature" aria-label="Selección destacada">
      <div class="feature-copy">
        <p class="eyebrow">Desde 1886</p>
        <h2>Un clásico que sigue sorprendiendo</h2>
        <p>De una receta nacida en Atlanta a una familia de bebidas que se disfruta en todo el mundo.</p>
        <a class="button" href="#coleccion">Explorar sabores <span aria-hidden="true">→</span></a>
      </div>
      <div class="feature-image" role="img" aria-label="Latas de refresco sobre un fondo rojo"></div>
    </section>
    <section class="collection" id="coleccion" aria-labelledby="collection-title">
      <div class="collection-head">
        <h2 id="collection-title">La colección</h2>
        <span class="count" id="result-count" aria-live="polite"></span>
      </div>
      <div class="controls">
        <div class="filters" role="group" aria-label="Filtrar bebidas">
          <button class="filter active" data-filter="todas" aria-pressed="true">Todas</button>
          <button class="filter" data-filter="clasica" aria-pressed="false">Clásicas</button>
          <button class="filter" data-filter="sin-azucar" aria-pressed="false">Sin azúcar</button>
          <button class="filter" data-filter="favoritas" aria-pressed="false">Favoritas</button>
        </div>
        <input class="search" id="search" type="search" placeholder="Buscar un sabor..." aria-label="Buscar bebidas">
      </div>
      <div class="grid" id="product-grid" aria-live="polite"></div>
    </section>
    <footer>
      <span>Archivo independiente creado para explorar bebidas y sabores.</span>
      <span>Las marcas y productos pertenecen a sus respectivos titulares.</span>
    </footer>
  </main>
  <dialog id="product-dialog" aria-labelledby="dialog-title">
    <img class="dialog-image" id="dialog-image" alt="">
    <div class="dialog-content">
      <button class="close" id="dialog-close" aria-label="Cerrar detalle">Cerrar ×</button>
      <p class="eyebrow" id="dialog-tag"></p>
      <h2 id="dialog-title"></h2>
      <p id="dialog-copy"></p>
    </div>
  </dialog>
  <script>
    const photo = "https://images.unsplash.com/photo-1554866585-cd94860890b7?auto=format&fit=crop&w=900&q=80";

    const products = [
      {
        id: "original", name: "Coca-Cola Original",
        category: "clasica", tag: "La original",
        note: "El sabor de siempre",
        description: "La bebida que inició una historia global en Atlanta, en 1886. Su receta y su sabor característico la convirtieron en todo un clásico.",
        position: "center"
      },
      {
        id: "zero", name: "Coca-Cola Zero",
        category: "sin-azucar", tag: "Sin azúcar",
        note: "Sabor intenso",
        description: "Una alternativa sin azúcar que conserva el carácter refrescante de Coca-Cola. Ideal para quienes buscan todo el sabor.",
        position: "left"
      },
      {
        id: "light", name: "Coca-Cola Light",
        category: "sin-azucar", tag: "Sin azúcar",
        note: "Ligera y refrescante",
        description: "Una versión ligera con una personalidad propia, reconocible por su perfil fresco y su larga trayectoria.",
        position: "right"
      },
      {
        id: "cherry", name: "Coca-Cola Cherry",
        category: "clasica", tag: "Sabor frutal",
        note: "Un toque de cereza",
        description: "El sabor clásico se encuentra con un toque frutal de cereza en una combinación pensada para quienes disfrutan probar algo diferente.",
        position: "center"
      },
      {
        id: "vanilla", name: "Coca-Cola Vanilla",
        category: "clasica", tag: "Sabor especial",
        note: "Notas de vainilla",
        description: "Una mezcla de Coca-Cola con notas dulces de vainilla. Una propuesta distinta dentro de la familia de sabores.",
        position: "left"
      },
      {
        id: "zero-cherry", name: "Zero Sugar Cherry",
        category: "sin-azucar", tag: "Sin azúcar",
        note: "Cereza, sin azúcar",
        description: "La combinación del perfil de cereza con una receta sin azúcar para sumar una opción más a la colección.",
        position: "right"
      },
      {
        id: "caffeine-free", name: "Caffeine Free",
        category: "clasica", tag: "Sin cafeína",
        note: "Un clásico diferente",
        description: "Una variante para quienes prefieren disfrutar el sabor de Coca-Cola en una opción sin cafeína.",
        position: "center"
      },
      {
        id: "zero-vanilla", name: "Zero Sugar Vanilla",
        category: "sin-azucar", tag: "Sin azúcar",
        note: "Vainilla suave",
        description: "El perfil de vainilla se suma a una alternativa sin azúcar: otro giro para explorar nuevos sabores.",
        position: "left"
      }
    ];
    const favorites = new Set(JSON.parse(localStorage.getItem("cola-favorites") || "[]"));
    const grid = document.querySelector("#product-grid");
    const search = document.querySelector("#search");
    const dialog = document.querySelector("#product-dialog");
    let activeFilter = "todas";

    function visibleProducts() {
      const query = search.value.trim().toLocaleLowerCase("es");
      return products.filter((product) => {
        const matchesText = `${product.name} ${product.note} ${product.tag}`.toLocaleLowerCase("es").includes(query);
        const matchesFilter = activeFilter === "todas"
          || (activeFilter === "favoritas"
            ? favorites.has(product.id)
            : product.category === activeFilter);
        return matchesText && matchesFilter;
      });
    }

    function render() {
      const items = visibleProducts();
      document.querySelector("#result-count").textContent = `${items.length} ${items.length === 1 ? "bebida" : "bebidas"}`;
      document.querySelector("#favorite-count").textContent = favorites.size;
      grid.replaceChildren();
      if (!items.length) {
        grid.innerHTML = '<p class="empty">No encontramos bebidas con esos filtros. Prueba otra búsqueda.</p>';
        return;
      }
      items.forEach((product, index) => {
        const article = document.createElement("article");
        article.className = "product";
        article.style.animationDelay = `${index * 45}ms`;
        article.innerHTML = `
          <div class="product-visual">
            <img src="${photo}" alt="Bebida refrescante, ${product.name}" loading="lazy" style="object-position:${product.position}">
            <span class="product-tag">${product.tag}</span>
            <button class="heart" aria-label="${favorites.has(product.id) ? "Quitar de favoritas" : "Añadir a favoritas"}: ${product.name}" aria-pressed="${favorites.has(product.id)}" data-favorite="${product.id}">${favorites.has(product.id) ? "♥" : "♡"}</button>
          </div>
          <div class="product-info">
            <div><h3>${product.name}</h3><p>${product.note}</p></div><button class="detail" data-detail="${product.id}">Ver detalle ↗</button>
          </div>`;
        grid.append(article);
      });
    }

    document.querySelector(".filters").addEventListener("click", (event) => {
      const button = event.target.closest("[data-filter]");
      if (!button) return;
      activeFilter = button.dataset.filter;
      document.querySelectorAll(".filter").forEach((filter) => {
        const selected = filter === button;
        filter.classList.toggle("active", selected);
        filter.setAttribute("aria-pressed", selected);
      });
      render();
    });

    search.addEventListener("input", render);
    grid.addEventListener("click", (event) => {
      const favoriteButton = event.target.closest("[data-favorite]");
      if (favoriteButton) {
        const id = favoriteButton.dataset.favorite;
        favorites.has(id) ? favorites.delete(id) : favorites.add(id);
        localStorage.setItem("cola-favorites", JSON.stringify([...favorites]));
        render();
        return;
      }
      const detailButton = event.target.closest("[data-detail]");
      if (!detailButton) return;
      const product = products.find((item) => item.id === detailButton.dataset.detail);
      document.querySelector("#dialog-image").src = photo;
      document.querySelector("#dialog-image").alt = product.name;
      document.querySelector("#dialog-tag").textContent = product.tag;
      document.querySelector("#dialog-title").textContent = product.name;
      document.querySelector("#dialog-copy").textContent = product.description;
      dialog.showModal();
    });

    document.querySelector("#dialog-close").addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    render();
  </script>
</body>
</html>
